{
  "name": "landfall",
  "private": true,
  "version": "0.1.0",
  "description": "LANDFALL — a provably-fair, pari-mutuel multiplayer instant game (local/educational build)",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @landfall/server dev\" \"pnpm --filter @landfall/web dev\"",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
