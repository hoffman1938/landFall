{
  "name": "landfall",
  "private": true,
  "version": "0.1.0",
  "description": "LANDFALL \u2014 a provably-fair, pari-mutuel multiplayer instant game (local/educational build)",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @landfall/server dev\" \"pnpm --filter @landfall/web dev\"",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22"
  }
}
