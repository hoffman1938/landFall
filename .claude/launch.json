{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landfall-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "iGaming", "--filter", "@landfall/server", "dev"],
      "port": 8787
    },
    {
      "name": "landfall-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "iGaming", "--filter", "@landfall/web", "dev"],
      "port": 5173
    },
    {
      "name": "landfall-worker",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "-c", "wrangler.jsonc", "--port", "8788", "--local"],
      "port": 8788
    }
  ]
}
